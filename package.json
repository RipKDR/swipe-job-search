{
  "name": "hi-hired",
  "version": "0.0.0",
  "private": true,
  "description": "Hi-Hired — swipe-based local casual job marketplace (Expo monorepo)",
  "scripts": {
    "dev:mobile": "pnpm --filter @hi-hired/mobile dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build:mobile": "pnpm --filter @hi-hired/mobile build"
  },
  "keywords": [
    "expo",
    "react-native",
    "supabase",
    "jobs",
    "swipe",
    "australia"
  ],
  "author": "Hi-Hired",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  }
}
