{
  "name": "hi-hired",
  "version": "0.0.0",
  "private": true,
  "description": "Hi-Hired — swipe-based local casual job marketplace (Expo monorepo)",
  "scripts": {
    "dev:mobile": "pnpm --filter @hi-hired/mobile dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build:mobile": "pnpm --filter @hi-hired/mobile build",
    "db:reset": "supabase db reset",
    "test:processor": "cd supabase/functions/notification-processor && deno test __tests__/",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "keywords": [
    "expo",
    "react-native",
    "supabase",
    "jobs",
    "swipe",
    "australia"
  ],
  "author": "Hi-Hired",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "pnpm@8.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "vite": ">=5.4.21",
      "lightningcss": "1.30.1"
    }
  },
  "dependencies": {
    "expo": "~52.0.49",
    "react": "18.3.1",
    "react-native": "0.76.9"
  }
}
