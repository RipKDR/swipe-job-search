# Hi-Hired mobile app — local/generated artifacts only
# See repo root .gitignore + STACK.md for env/secrets policy

# Dependencies
node_modules/

# Expo / Metro
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Env (never commit secrets; .env.example is tracked)
.env
.env.local
.env.development
.env.staging
.env.production

# TypeScript
*.tsbuildinfo

# Native build outputs
*.apk
*.aab
*.ipa
*.jsbundle

# Debug logs
npm-debug.*
yarn-debug.*
yarn-error.*
pnpm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE (keep shared vscode settings at repo root)
.idea/
.cursor/
*.sublime-project
*.sublime-workspace

# Test / coverage
coverage/
tmp/
temp/
logs/

# Local tooling / agent artifacts
.worktrees/
worktrees/
ruvector.db
agentdb.rvf
agentdb.rvf.lock
.sentryclirc
posthog*.json
.metro-stubs/
