# Copy to .env.local and fill with your Supabase project values.
# Linked project ref for this repo: rwzzdsiawcovyfsnmiiy
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_PROJECT_ID=
EXPO_PUBLIC_POSTHOG_PAT=
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_ORG=
EXPO_PUBLIC_SENTRY_PROJECT=
EXPO_PUBLIC_APP_ENV=staging

# Optional: pin auth callback origin when window.location differs from Supabase Site URL
# (e.g. always open http://localhost:8081 even if you sometimes use 127.0.0.1).
# Leave unset to use the current browser origin on web.
# EXPO_PUBLIC_AUTH_REDIRECT_ORIGIN=http://localhost:8081

# Dev note: Supabase Auth rate-limits magic-link OTP sends per email (~few/hour).
# If you see HTTP 429 on login, wait several minutes or use Google OAuth instead of
# hammering the same test email. Cooldown persists in sessionStorage on web refresh.

# Supabase Auth — URL Configuration (Dashboard → Authentication → URL Configuration)
#
# Site URL (local web dev): http://localhost:8081  (or http://127.0.0.1:8081 — pick one
# and use the same host in the browser; add BOTH redirect URLs below if you switch hosts)
#
# Redirect URLs — add every callback URL your app sends as redirect_to / emailRedirectTo.
# HTTP 400 (not 429) on POST /auth/v1/otp usually means redirect URL or email validation.
#
# Expo web (local):
#   http://localhost:8081/callback
#   http://127.0.0.1:8081/callback
# Native deep link (app.config.ts scheme: hi-hired):
#   hi-hired://auth/callback
# Production web (replace host):
#   https://your-domain/callback
#
# Google Cloud Console: authorized redirect URI must include Supabase callback, e.g.
#   https://<project-ref>.supabase.co/auth/v1/callback
