# Hi-Hired mobile env (Phase 1)
# Copy to .env.local (never commit)
# See STACK.md § Environment Variables Matrix (dev/staging/prod + 3 Supabase projects)
# Loaded via expo-constants extra in app.config.ts (client-safe EXPO_PUBLIC_* only)

EXPO_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

EXPO_PUBLIC_POSTHOG_KEY=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_APP_ENV=development

# EAS projectId set in EAS dashboard (one per env matrix)
# EAS_PROJECT_ID=xxxx

# Deep link dev: exp://127.0.0.1:8081/--/auth/callback (auto from expo)
# Prod: hi-hired://auth/callback (configure in Supabase Auth > URL config)