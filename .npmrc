# pnpm config for Hi-Hired Expo monorepo (SDK 52+/v55/56 + RN native modules)
# Per 2026-05-28 scaffold plan + STACK.md + EXPO_2026.md (Context7 expo_dev 86.3)
# Hoist for compatibility with react-native, expo, reanimated, gesture-handler etc.
shamefully-hoist=true
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
strict-peer-dependencies=false
auto-install-peers=true

# Relaxed for CI/dev: eslint-visitor-keys@5 requires Node ^20.19 (CI uses same flag)
engine-strict=false