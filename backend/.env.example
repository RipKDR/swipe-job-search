# Hi-Hired Backend
# =================
# Copy to .env and fill in your values.

# ── Settings prefix ──────────────────────────────────────────────────────
# All settings use the HH_ prefix (Pydantic Settings env_prefix).
# Example: HH_SUPABASE_URL maps to Settings.supabase_url.

# --- Supabase ---
HH_SUPABASE_URL=
HH_SUPABASE_SERVICE_KEY=
HH_SUPABASE_JWT_SECRET=

# --- Redis ---
HH_REDIS_URL=redis://localhost:6379/0

# --- Celery (separate Redis config if different from HH_REDIS_URL) ---
HH_CELERY_BROKER_URL=redis://localhost:6379/0
HH_CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Qdrant ---
HH_QDRANT_URL=:memory:
HH_QDRANT_API_KEY=

# --- Observability (OpenTelemetry) ---
HH_OTLP_ENDPOINT=
# Set to your OTLP collector (e.g. http://grafana-tempo:4317) or leave
# empty to disable tracing.

HH_PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc

# --- API ---
HH_API_HOST=0.0.0.0
HH_API_PORT=8000
HH_CORS_ORIGINS=http://localhost:8081,http://localhost:3000
HH_LOG_LEVEL=info

# --- Secrets (Vault) ---
HH_VAULT_ADDR=
HH_VAULT_TOKEN=
# Falls back to HH_-prefixed environment variables when Vault is unavailable.
