# Hi-Hired Backend
# =================
# Copy to .env and fill in your values.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Observability (OpenTelemetry) ---
OTLP_ENDPOINT=http://localhost:4317
# Set to your OTLP-compatible collector (Jaeger, Grafana Tempo, etc.)
# Leave empty to disable tracing.

PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus_multiproc
# Directory for Prometheus multi-process metrics (gunicorn/celery).

# --- Secrets (Vault) ---
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
# For production, replace with your Vault instance address and token.
# Falls back to HH_-prefixed environment variables when Vault is unavailable.
