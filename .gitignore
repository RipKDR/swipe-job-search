# Hi-Hired monorepo .gitignore (scaffold Phase 1, 2026-05-28)
# See docs/ops/ for retention, SECURITY.md for PII, STACK.md for env

# Dependencies
node_modules/
.pnp/
.pnp.js
.yarn/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.xcworkspace/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (never commit secrets)
.env
.env*.local
.env.development
.env.staging
.env.production

# typescript
*.tsbuildinfo

# pnpm
.pnpm-debug.log

# Supabase local (when running supabase start)
supabase/.branches
supabase/.temp
supabase/seed.sql

# EAS / builds (local)
*.apk
*.aab
*.ipa
*.zip
eas.json

# IDE / editor
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.cursor/
*.sublime-project
*.sublime-workspace

# Logs
logs
*.log

# Misc
coverage/
*.tgz
.DS_Store
Thumbs.db

# Keep package-lock? no (pnpm)
package-lock.json
yarn.lock

# Python backend
backend/.venv/
backend/**/__pycache__/
backend/**/*.pyc
backend/mlruns*
**/__pycache__/
**/*.pyc
*.egg-info/

# MLflow
mlruns/
mlruns_test*/
mlruns_test/

# Audit screenshots (generated, not source)
audit/screenshots/

# Test artifacts
.ruff_cache/
.pytest_cache/
htmlcov/

# Local agent artifacts
ruvector.db
agentdb.rvf
agentdb.rvf.lock
pnpm
=


# Claude worktrees (parallel agent sessions)
.claude/worktrees/
.claude/settings.local.json


#Ignore vscode AI rules
.github\instructions\codacy.instructions.md
